CREATE TABLE futbinsp5.cards(
    ID int NOT NULL AUTO_INCREMENT PRIMARY KEY,
    CLUB_ID int NOT NULL,
    POSITION_ID int NOT NULL,
    ALTERNATE_POSITION_ID int,
