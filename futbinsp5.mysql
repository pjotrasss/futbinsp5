    CARD_IMG_URL varchar(30) NOT NULL,
    FOREIGN KEY (CLUB_ID) REFERENCES clubs(ID),
    FOREIGN KEY (ALTERNATE_POSITION_ID) REFERENCES positions(ID),
    FOREIGN KEY (ALTERNATE_POSITION2_ID) REFERENCES positions(ID)
);

