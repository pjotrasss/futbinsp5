CREATE TABLE futbinsp5.privilege_levels(
    ID int NOT NULL AUTO_INCREMENT PRIMARY KEY,
    PRIVILEGE_LEVEL varchar(25)
);

INSERT INTO futbinsp5.privilege_levels(PRIVILEGE_LEVEL) VALUES
('transfermaster'),
('club_owner');

CREATE TABLE futbinsp5.users(
    ID int NOT NULL AUTO_INCREMENT PRIMARY KEY,
    PRIVILEGE_LEVEL_ID int NOT NULL,
    USERNAME varchar(25),
    DISCORD_TAG varchar(25),
    FOREIGN KEY (PRIVILEGE_LEVEL_ID) REFERENCES privilege_levels(ID)
);

