CREATE TABLE futbinsp5.clubs(
    ID int NOT NULL AUTO_INCREMENT PRIMARY KEY,
    OWNER_ID int NOT NULL,
    CLUB varchar(30),
    LOGO_URL varchar(30),
    BANNER_URL varchar(35),
    ACTIVE boolean,
    FOREIGN KEY (OWNER_ID) REFERENCES users(ID)
);

